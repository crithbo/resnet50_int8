{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server_waveform_portable_runtime_receipt_v1.schema.json",
  "title": "Portable waveform runtime receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "rule_id", "profile_sha256", "package_id", "execution_id", "attempt_id",
    "attempt_root", "first_fresh_for_profile", "capture_mode", "simulation_started", "exit_kind",
    "actual_sim_argv", "dump_tcl", "raw_vpd_runtime_receipt", "portable_vcd",
    "signal_query_receipt", "return_allowlist", "no_byte_limit", "no_event_limit",
    "sampling", "truncation", "diagnostic_status", "return_must_publish", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "server-waveform-portable-runtime-receipt-v1"},
    "rule_id": {"const": "CDA-SERVER-WAVEFORM-PORTABLE-LOCAL-DECODABILITY-001"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "package_id": {"$ref": "#/$defs/name"},
    "execution_id": {"$ref": "#/$defs/name"},
    "attempt_id": {"$ref": "#/$defs/name"},
    "attempt_root": {"$ref": "#/$defs/path"},
    "first_fresh_for_profile": {"type": "boolean"},
    "capture_mode": {"enum": ["DIRECT_VCD_AND_QUERY", "QUERY_ONLY"]},
    "simulation_started": {"type": "boolean"},
    "exit_kind": {"enum": ["COMPILE_FAILURE", "SIMULATION_NOT_STARTED", "NATURAL", "TIMEOUT", "HUP", "INT", "TERM", "SIMULATION_NONZERO"]},
    "actual_sim_argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dump_tcl": {"$ref": "#/$defs/identity"},
    "raw_vpd_runtime_receipt": {"$ref": "#/$defs/identity"},
    "portable_vcd": {"type": "object"},
    "signal_query_receipt": {"type": "object"},
    "return_allowlist": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "no_byte_limit": {"const": true},
    "no_event_limit": {"const": true},
    "sampling": {"const": false},
    "truncation": {"const": false},
    "diagnostic_status": {"enum": ["COMPLETE", "DIAGNOSTIC_EVIDENCE_INCOMPLETE", "NOT_APPLICABLE_SIMULATION_NOT_STARTED"]},
    "return_must_publish": {"const": true},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
