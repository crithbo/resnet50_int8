{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-maintenance-incident-adjudication-v1",
  "title": "Rule maintenance incident adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "incident_id",
    "classification",
    "evidence",
    "current_rule_ids",
    "current_rule_audit",
    "action",
    "positive_controls",
    "negative_controls",
    "claim_boundary"
  ],
  "properties": {
    "schema_id": {"const": "rule-maintenance-incident-adjudication-v1"},
    "incident_id": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "RULE_SEMANTIC_ERROR",
        "RULE_SEMANTIC_OMISSION",
        "IMPLEMENTATION_ESCAPE",
        "SESSION_EXECUTION_NONCOMPLIANCE",
        "ONE_OFF_OR_DOMAIN_FAILURE"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "current_rule_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^CDA-[A-Z0-9_-]+-[0-9]{3}$"},
      "uniqueItems": true
    },
    "current_rule_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_coverage", "implementation_coverage", "summary"],
      "properties": {
        "semantic_coverage": {"enum": ["COVERED", "INCORRECT", "MISSING", "NOT_APPLICABLE"]},
        "implementation_coverage": {"enum": ["PASS", "ESCAPED", "NOT_APPLICABLE"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_rule_change",
        "hard_gate_change",
        "workflow_change",
        "text_delta_policy",
        "causal_blocking_classes",
        "affected_consumers",
        "preserved_sections",
        "replaced_or_removed_sections"
      ],
      "properties": {
        "public_rule_change": {
          "enum": ["NONE", "REPLACE_OR_NARROW", "MERGE_OMISSION", "DELETE_OR_ARCHIVE"]
        },
        "hard_gate_change": {"enum": ["NONE", "FIX_IMPLEMENTATION", "ADD_OR_STRENGTHEN"]},
        "workflow_change": {"enum": ["NONE", "SKILL_OR_HANDOFF", "OWNER_LOCAL_FIX"]},
        "text_delta_policy": {"const": "REPLACE_MERGE_DELETE_NOT_APPEND_ONLY"},
        "causal_blocking_classes": {
          "type": "array",
          "items": {"enum": ["server_start", "actual_input", "state_safety", "return"]},
          "uniqueItems": true
        },
        "affected_consumers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "preserved_sections": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "replaced_or_removed_sections": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "positive_controls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "negative_controls": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
