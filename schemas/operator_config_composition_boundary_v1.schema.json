{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator_config_composition_boundary_v1.schema.json",
  "title": "Operator primitive composition boundary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "family",
    "boundaries",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "operator_config_composition_boundary_v1"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary_id",
          "producer_dtype",
          "consumer_dtype",
          "shape",
          "layout",
          "producer_byte_set",
          "consumer_required_byte_set",
          "transaction_bytes",
          "tag_last",
          "clock_handshake",
          "lifetime_visibility",
          "qparam_rounding",
          "status",
          "evidence"
        ],
        "properties": {
          "boundary_id": {"type": "string", "minLength": 1},
          "producer_dtype": {"type": "string", "minLength": 1},
          "consumer_dtype": {"type": "string", "minLength": 1},
          "shape": {"type": "string", "minLength": 1},
          "layout": {"type": "string", "minLength": 1},
          "producer_byte_set": {"type": "string", "minLength": 1},
          "consumer_required_byte_set": {"type": "string", "minLength": 1},
          "transaction_bytes": {"type": "integer", "minimum": 1},
          "tag_last": {"type": "string", "minLength": 1},
          "clock_handshake": {"type": "string", "minLength": 1},
          "lifetime_visibility": {"type": "string", "minLength": 1},
          "qparam_rounding": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
