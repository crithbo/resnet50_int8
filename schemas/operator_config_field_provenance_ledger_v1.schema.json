{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator_config_field_provenance_ledger_v1.schema.json",
  "title": "Operator configuration field provenance ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "family",
    "candidate_json_sha256",
    "entries",
    "source_absences",
    "claim_boundary"
  ],
  "properties": {
    "schema": {
      "const": "operator_config_field_provenance_ledger_v1"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "candidate_json_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "source_absences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/absence"
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "boundFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "blob_oid",
        "file_sha256",
        "json_pointer",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 7
        },
        "blob_oid": {
          "type": "string",
          "minLength": 7
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "value": true
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_pointer",
        "target_value",
        "origin",
        "applicability_class",
        "exactness_axes",
        "owner",
        "consumer_equation",
        "derivation_receipt",
        "source",
        "negative_control_ids",
        "status"
      ],
      "properties": {
        "json_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "target_value": true,
        "origin": {
          "enum": [
            "REFERENCE_EXACT",
            "MODEL_DERIVED",
            "RTL_DERIVED",
            "ENCODER_DERIVED",
            "ADDRESS_PLANNER_DERIVED",
            "SCHEDULE_DERIVED",
            "EXPLICIT_DISABLED",
            "UNRESOLVED"
          ]
        },
        "applicability_class": {
          "enum": [
            "EXACT_SOURCE_INSTANCE",
            "PROVEN_INVARIANT",
            "DERIVED_FOR_TARGET",
            "EXPLICITLY_INACTIVE",
            "UNRESOLVED"
          ]
        },
        "exactness_axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "dtype",
            "shape",
            "layout",
            "qparams",
            "topology",
            "address",
            "schedule",
            "consumer"
          ],
          "properties": {
            "op": {"type": "boolean"},
            "dtype": {"type": "boolean"},
            "shape": {"type": "boolean"},
            "layout": {"type": "boolean"},
            "qparams": {"type": "boolean"},
            "topology": {"type": "boolean"},
            "address": {"type": "boolean"},
            "schedule": {"type": "boolean"},
            "consumer": {"type": "boolean"}
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "consumer_equation": {
          "type": "string",
          "minLength": 1
        },
        "derivation_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/boundFile"}
          ]
        },
        "source": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/source"}
          ]
        },
        "negative_control_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_json_pointer",
        "state",
        "reason",
        "owner"
      ],
      "properties": {
        "target_json_pointer": {
          "type": "string",
          "pattern": "^/"
        },
        "state": {
          "enum": [
            "SOURCE_ABSENT_NOT_APPLICABLE",
            "SOURCE_ABSENT_UNKNOWN_FOR_TARGET",
            "EXPLICIT_NULL_INACTIVE",
            "EXPLICIT_ZERO",
            "TARGET_REQUIRED_DERIVED"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
