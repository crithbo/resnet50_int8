{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crithbo/resnet50_int8/schemas/comparison_request.schema.json",
  "title": "Logical tensor comparison request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "required_sources", "tensors"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "comparison_id": {"type": "string", "minLength": 1},
    "required_sources": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tensor_id", "sources"],
        "properties": {
          "tensor_id": {"type": "string", "minLength": 1},
          "onnx_node_id": {"type": ["string", "null"]},
          "hw_op_id": {"type": ["string", "null"]},
          "topology_index": {"type": "integer"},
          "atol": {"type": ["number", "null"], "minimum": 0},
          "rtol": {"type": ["number", "null"], "minimum": 0},
          "sources": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/source"}
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["available", "missing", "layout_inverse_failure"]
        },
        "path": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1},
        "provenance": {"type": "object"}
      }
    }
  }
}
