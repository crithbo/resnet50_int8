{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crithbo/resnet50_int8/schemas/hardware_approval.schema.json",
  "title": "W4 DeepSeek-inherited Trassic2 RTL28 physical baseline approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_type", "status", "approval_scope", "approval_id",
    "authority", "target_version", "baseline_confirmation", "architecture",
    "network_profile", "operator_bindings", "contract_layers", "deferred_to_w5",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "contract_type": {"const": "w4_hardware_baseline_approval"},
    "status": {"const": "approved"},
    "approval_scope": {"const": "w4_profile_and_physical_layout_only"},
    "approval_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authority_id", "role", "recorded_at"],
      "properties": {
        "kind": {"enum": ["project_operator", "synthetic_fixture"]},
        "authority_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date"}
      }
    },
    "target_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "rtl_commit", "top_module", "filelist", "architecture_id",
        "architecture_schema_version", "isa_version", "register_map_version",
        "config_repository", "config_commit"
      ],
      "properties": {
        "repository": {"const": "https://github.com/xlsjdjdk/Trassic2.0_RTL"},
        "rtl_commit": {"const": "e3bdebba95dec36ee8eba43caa92a326a88392cd"},
        "top_module": {"const": "NDP_Top_new"},
        "filelist": {"const": "code/NDP_rtl/filelists/NDP_Top_filelist.f"},
        "architecture_id": {"const": "trassic2_rtl28_candidate_v1"},
        "architecture_schema_version": {"const": "0.2"},
        "isa_version": {"const": "trassic2-command64-rtl-e3bdebba-v1"},
        "register_map_version": {"const": "ndp-sim-register-map-groups1-006ca83f-v1"},
        "config_repository": {"const": "https://github.com/uSFrances/ndp-sim.git"},
        "config_commit": {"const": "e299b2804448242d1589b3e58ed7c5a9a5eca09f"}
      }
    },
    "baseline_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "basis", "inherited_project", "elaboration_log_claimed",
        "decision_uri", "decision_sha256"
      ],
      "properties": {
        "status": {"const": "operator_confirmed_known_good"},
        "basis": {"const": "operator_statement_and_completed_deepseek_bringup"},
        "inherited_project": {"const": "deepseek_full_network"},
        "elaboration_log_claimed": {"const": false},
        "decision_uri": {"const": ".agents/decisions/ADR-009-deepseek-baseline-inheritance.md"},
        "decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_family", "slice_count", "topology_id", "specialized_array",
        "general_array", "instruction_mask_bits", "dram"
      ],
      "properties": {
        "target_family": {"const": "rtl28"},
        "slice_count": {"const": 28},
        "topology_id": {"const": "rtl28_high7x4_low28_e3bdebba"},
        "specialized_array": {
          "type": "object", "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {"rows": {"const": 8}, "cols": {"const": 8}}
        },
        "general_array": {
          "type": "object", "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {"rows": {"const": 4}, "cols": {"const": 4}}
        },
        "instruction_mask_bits": {"const": 28},
        "dram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bank_count", "row_count", "col_count", "subword_bytes",
            "address_unit", "address_order"
          ],
          "properties": {
            "bank_count": {"const": 4},
            "row_count": {"const": 6144},
            "col_count": {"const": 64},
            "subword_bytes": {"const": 16},
            "address_unit": {"const": "byte"},
            "address_order": {"const": "slice_owner, local_bank, row, column, byte_offset"}
          }
        }
      }
    },
    "network_profile": {"const": "w4_deepseek_hybrid28_resnet50_v1"},
    "operator_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple", "view", "conv", "maxpool", "add", "global_average_pool", "matmul"],
      "properties": {
        "simple": {"$ref": "#/$defs/simple_binding"},
        "view": {"$ref": "#/$defs/view_binding"},
        "conv": {"$ref": "#/$defs/conv_binding"},
        "maxpool": {"$ref": "#/$defs/maxpool_binding"},
        "add": {"$ref": "#/$defs/add_binding"},
        "global_average_pool": {"$ref": "#/$defs/gap_binding"},
        "matmul": {"$ref": "#/$defs/matmul_binding"}
      }
    },
    "contract_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_baseline", "resnet_delta"],
      "properties": {
        "common_baseline": {
          "$ref": "#/$defs/contract_reference",
          "properties": {
            "contract_id": {"const": "deepseek-rtl28-physical-baseline-e299b280-v1"},
            "path": {"const": "contracts/deepseek_rtl28_physical_baseline.json"}
          }
        },
        "resnet_delta": {
          "$ref": "#/$defs/contract_reference",
          "properties": {
            "contract_id": {"const": "resnet50-rtl28-w4-deepseek-hybrid-delta-v1"},
            "path": {"const": "contracts/resnet50_rtl28_w4_delta.json"}
          }
        }
      }
    },
    "deferred_to_w5": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "int8_conv_sa_bias_psum_requant_configuration"}},
        {"contains": {"const": "int8_matmul_tail_psum_requant_configuration"}},
        {"contains": {"const": "typed_qparams_to_register_or_stream_binding"}},
        {"contains": {"const": "target_numerical_simulator_execution"}},
        {"contains": {"const": "hardware_runtime_load_wait_dump_protocol"}}
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "contract_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "path", "sha256"],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "simple_binding": {"$ref": "#/$defs/local_binding", "properties": {"layout_id": {"const": "w4_simple_group4x7_28_candidate_v1"}}},
    "view_binding": {"$ref": "#/$defs/local_binding", "properties": {"layout_id": {"const": "w4_zero_copy_view_group4x7_28_candidate_v1"}}},
    "conv_binding": {"$ref": "#/$defs/high4_binding", "properties": {"layout_id": {"const": "w4_conv_group4x7_28_candidate_v1"}}},
    "maxpool_binding": {"$ref": "#/$defs/local_binding", "properties": {"layout_id": {"const": "w4_maxpool_group4x7_28_candidate_v1"}}},
    "add_binding": {"$ref": "#/$defs/local_binding", "properties": {"layout_id": {"const": "w4_qlinearadd_group4x7_28_candidate_v1"}}},
    "gap_binding": {"$ref": "#/$defs/local_binding", "properties": {"layout_id": {"const": "w4_globalavgpool_group4x7_28_candidate_v1"}}},
    "matmul_binding": {"$ref": "#/$defs/high4_binding", "properties": {"layout_id": {"const": "w4_qlinearmatmul_group4x7_28_candidate_v1"}}},
    "local_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["layout_id", "communication_domain"],
      "properties": {"layout_id": {"type": "string"}, "communication_domain": {"const": "local"}}
    },
    "high4_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["layout_id", "communication_domain"],
      "properties": {"layout_id": {"type": "string"}, "communication_domain": {"const": "high4"}}
    }
  }
}
