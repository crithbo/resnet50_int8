{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/crithbo/resnet50_int8/schemas/hardware_approval.schema.json",
  "title": "Versioned Trassic2 RTL28 hardware approval contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_type", "status", "approval_id", "authority",
    "target_version", "clean_elaboration", "architecture", "network_profile",
    "operator_layouts", "physical_objects", "numeric_semantics", "isa",
    "runtime_protocol", "evidence"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "contract_type": {"const": "hardware_approval"},
    "status": {"const": "approved"},
    "approval_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "approved_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "organization": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date"}
      }
    },
    "target_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "rtl_commit", "top_module", "filelist",
        "architecture_id", "architecture_schema_version", "isa_version",
        "register_map_version"
      ],
      "properties": {
        "repository": {"const": "https://github.com/xlsjdjdk/Trassic2.0_RTL"},
        "rtl_commit": {"const": "e3bdebba95dec36ee8eba43caa92a326a88392cd"},
        "top_module": {"const": "NDP_Top_new"},
        "filelist": {"const": "code/NDP_rtl/filelists/NDP_Top_filelist.f"},
        "architecture_id": {"const": "trassic2_rtl28_candidate_v1"},
        "architecture_schema_version": {"const": "0.2"},
        "isa_version": {"type": "string", "minLength": 1},
        "register_map_version": {"type": "string", "minLength": 1}
      }
    },
    "clean_elaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tool", "tool_version", "log_uri", "log_sha256"],
      "properties": {
        "status": {"const": "approved"},
        "tool": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "log_uri": {"type": "string", "minLength": 1},
        "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "network_profile": {
      "enum": [
        "w4_group4x7_batch_channel28_candidate_v1",
        "w4_global_ring28_candidate_v1"
      ]
    },
    "operator_layouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simple", "view", "conv", "maxpool", "add", "global_average_pool", "matmul"],
      "properties": {
        "simple": {"type": "string", "minLength": 1},
        "view": {"type": "string", "minLength": 1},
        "conv": {"type": "string", "minLength": 1},
        "maxpool": {"type": "string", "minLength": 1},
        "add": {"type": "string", "minLength": 1},
        "global_average_pool": {"type": "string", "minLength": 1},
        "matmul": {"type": "string", "minLength": 1}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_family", "slice_count", "topology_id", "specialized_array",
        "general_array", "instruction_mask_bits", "dram"
      ],
      "properties": {
        "target_family": {"const": "rtl28"},
        "slice_count": {"const": 28},
        "topology_id": {"const": "rtl28_high7x4_low28_e3bdebba"},
        "specialized_array": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {"rows": {"const": 8}, "cols": {"const": 8}}
        },
        "general_array": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows", "cols"],
          "properties": {"rows": {"const": 4}, "cols": {"const": 4}}
        },
        "instruction_mask_bits": {"const": 28},
        "dram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bank_count", "row_count", "col_count", "subword_bytes", "address_unit", "address_order"],
          "properties": {
            "bank_count": {"const": 4},
            "row_count": {"const": 6144},
            "col_count": {"const": 64},
            "subword_bytes": {"const": 16},
            "address_unit": {"const": "byte"},
            "address_order": {"const": "slice_owner, local_bank, row, column, byte_offset"}
          }
        }
      }
    },
    "physical_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation", "weight", "bias", "qparams", "psum", "output"],
      "properties": {
        "activation": {"$ref": "#/$defs/physical_object"},
        "weight": {"$ref": "#/$defs/physical_object"},
        "bias": {"$ref": "#/$defs/physical_object"},
        "qparams": {"$ref": "#/$defs/physical_object"},
        "psum": {"$ref": "#/$defs/physical_object"},
        "output": {"$ref": "#/$defs/physical_object"}
      }
    },
    "numeric_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accumulator_bits", "overflow", "requant", "qparams_transport", "psum_lifecycle"],
      "properties": {
        "accumulator_bits": {"type": "integer", "minimum": 32},
        "overflow": {"enum": ["wrap", "saturate", "error"]},
        "requant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["multiplier_encoding", "rounding", "saturation", "zero_point_stage"],
          "properties": {
            "multiplier_encoding": {"type": "string", "minLength": 1},
            "rounding": {"const": "nearest_even"},
            "saturation": {"const": "uint8"},
            "zero_point_stage": {"type": "string", "minLength": 1}
          }
        },
        "qparams_transport": {"type": "string", "minLength": 1},
        "psum_lifecycle": {"type": "string", "minLength": 1}
      }
    },
    "isa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opcodes", "field_widths", "instruction_mask_semantics"],
      "properties": {
        "opcodes": {"$ref": "#/$defs/nonnegative_integer_map"},
        "field_widths": {
          "type": "object",
          "minProperties": 1,
          "required": ["slice_mask"],
          "properties": {"slice_mask": {"const": 28}},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "instruction_mask_semantics": {"type": "string", "minLength": 1}
      }
    },
    "runtime_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_config", "load_data", "start", "wait", "status", "error", "dump"],
      "properties": {
        "load_config": {"type": "string", "minLength": 1},
        "load_data": {"type": "string", "minLength": 1},
        "start": {"type": "string", "minLength": 1},
        "wait": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1},
        "dump": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "uri", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network_profile": {"const": "w4_group4x7_batch_channel28_candidate_v1"}
        },
        "required": ["network_profile"]
      },
      "then": {
        "properties": {
          "operator_layouts": {
            "properties": {
              "simple": {"const": "w4_simple_group4x7_28_candidate_v1"},
              "view": {"const": "w4_zero_copy_view_group4x7_28_candidate_v1"},
              "conv": {"const": "w4_conv_group4x7_28_candidate_v1"},
              "maxpool": {"const": "w4_maxpool_group4x7_28_candidate_v1"},
              "add": {"const": "w4_qlinearadd_group4x7_28_candidate_v1"},
              "global_average_pool": {"const": "w4_globalavgpool_group4x7_28_candidate_v1"},
              "matmul": {"const": "w4_qlinearmatmul_group4x7_28_candidate_v1"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "network_profile": {"const": "w4_global_ring28_candidate_v1"}
        },
        "required": ["network_profile"]
      },
      "then": {
        "properties": {
          "operator_layouts": {
            "properties": {
              "simple": {"const": "w4_simple_global_ring28_candidate_v1"},
              "view": {"const": "w4_zero_copy_view_global_ring28_candidate_v1"},
              "conv": {"const": "w4_conv_global_ring28_candidate_v1"},
              "maxpool": {"const": "w4_maxpool_global_ring28_candidate_v1"},
              "add": {"const": "w4_qlinearadd_global_ring28_candidate_v1"},
              "global_average_pool": {"const": "w4_globalavgpool_global_ring28_candidate_v1"},
              "matmul": {"const": "w4_qlinearmatmul_global_ring28_candidate_v1"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "physical_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "axis_order", "alignment_bytes", "tail_rule", "address_unit"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "axis_order": {"type": "string", "minLength": 1},
        "alignment_bytes": {"type": "integer", "minimum": 1},
        "tail_rule": {"type": "string", "minLength": 1},
        "address_unit": {"type": "string", "minLength": 1}
      }
    },
    "nonnegative_integer_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "positive_integer_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
