{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server_package_gate_results_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "results"],
  "properties": {
    "schema": {"const": "server-package-gate-results-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "pass", "errors", "warnings"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "pass": {"type": "boolean"},
          "errors": {"type": "array", "items": {"type": "string"}},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "receipt": {"type": ["object", "null"]}
        }
      }
    }
  }
}
