{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server_logger_parser_format_trace_v1.schema.json",
  "title": "Exact logger rendering to parser format trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_id",
    "fixture_id",
    "historical_binding",
    "source_bindings",
    "logger_contract",
    "parser_contract"
  ],
  "properties": {
    "schema": {
      "const": "server_logger_parser_format_trace_v1"
    },
    "rule_id": {
      "const": "CDA-SERVER-DIAGNOSTIC-LOGGER-PARSER-EXACT-FORMAT-TRACE-001"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "historical_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "source_package_sha256",
        "return_sha256",
        "analysis_sha256"
      ],
      "properties": {
        "family": {"const": "global_average_pool"},
        "source_package_sha256": {"$ref": "#/$defs/sha256"},
        "return_sha256": {"$ref": "#/$defs/sha256"},
        "analysis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logger", "parser"],
      "properties": {
        "logger": {"$ref": "#/$defs/sourceBinding"},
        "parser": {"$ref": "#/$defs/sourceBinding"}
      }
    },
    "logger_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_language",
        "record_marker",
        "event_format_string",
        "event_render_mode",
        "event_container_width",
        "padding_char",
        "event_tokens",
        "field_names"
      ],
      "properties": {
        "source_language": {"const": "SYSTEMVERILOG_FDISPLAY"},
        "record_marker": {"type": "string", "minLength": 1},
        "event_format_string": {"enum": ["%s", "%0s"]},
        "event_render_mode": {
          "enum": ["RIGHT_JUSTIFIED_FIXED_WIDTH", "UNPADDED"]
        },
        "event_container_width": {"type": "integer", "minimum": 0},
        "padding_char": {"type": "string", "minLength": 1, "maxLength": 1},
        "event_tokens": {
          "const": ["QUALIFIED_EDGE", "FACTOR_EDGE", "HEARTBEAT"]
        },
        "field_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      }
    },
    "parser_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_prefix_regex",
        "event_capture_regex",
        "normalization_mode",
        "normalization_padding_char",
        "normalization_max_padding_chars"
      ],
      "properties": {
        "event_prefix_regex": {"type": "string", "minLength": 1},
        "event_capture_regex": {"type": "string", "minLength": 1},
        "normalization_mode": {
          "enum": [
            "NONE",
            "STRIP_DECLARED_LEADING_PADDING_AFTER_EVENT_EQUALS"
          ]
        },
        "normalization_padding_char": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "normalization_max_padding_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_path", "sha256", "source_span"],
      "properties": {
        "member_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_span": {"type": "string", "minLength": 1}
      }
    }
  }
}
