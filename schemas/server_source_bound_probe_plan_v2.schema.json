{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-source-bound-probe-plan-v2",
  "title": "Source-bound causal probe plan with exact target and payload semantics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_id",
    "profile",
    "package_id",
    "family",
    "catalog_identity",
    "diagnostic_semantics",
    "boundaries",
    "role_coverage",
    "decision_observations",
    "candidates",
    "runtime_budget",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "server-source-bound-probe-plan-v2"},
    "rule_id": {"const": "CDA-SERVER-SOURCE-BOUND-GENERATED-OBSERVER-001"},
    "profile": {"const": "HIGH_INFORMATION_CAUSAL_V1"},
    "package_id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "catalog_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rtl_tree_sha256", "catalog_semantic_sha256"],
      "properties": {
        "rtl_tree_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_semantic_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "diagnostic_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_match",
        "record_grouping_key",
        "unknown_payload",
        "numeric_parse_failure",
        "candidate_match_cardinality"
      ],
      "properties": {
        "instance_match": {"const": "EXACT_CANONICAL_EQUALITY"},
        "record_grouping_key": {
          "const": ["boundary_id", "canonical_instance", "seq"]
        },
        "unknown_payload": {"const": "EVIDENCE_INCOMPLETE"},
        "numeric_parse_failure": {"const": "EVIDENCE_INCOMPLETE"},
        "candidate_match_cardinality": {"const": "EXACTLY_ONE"}
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/boundary"}
    },
    "role_coverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "disposition", "boundary_ids", "reason"],
        "properties": {
          "role": {"$ref": "#/$defs/role"},
          "disposition": {"enum": ["covered", "not_applicable"]},
          "boundary_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string"}
        }
      }
    },
    "decision_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "boundary_id", "metric"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "boundary_id": {"type": "string", "minLength": 1},
          "metric": {"enum": ["summary_present", "count_nonzero", "class_seen"]},
          "class_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "root_cause_class", "signature"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "root_cause_class": {"type": "string", "minLength": 1},
          "signature": {
            "type": "object",
            "additionalProperties": {"type": "boolean"}
          }
        }
      }
    },
    "runtime_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_ring_depth",
        "non_progress_ring_depth",
        "first_payload_samples",
        "post_trigger_samples",
        "no_progress_cycles",
        "max_log_bytes",
        "state_activity_consumes_qualified_budget",
        "multiclass_encoding",
        "text_io_policy",
        "slowdown_limit_hard"
      ],
      "properties": {
        "qualified_ring_depth": {"type": "integer", "minimum": 1, "maximum": 4096},
        "non_progress_ring_depth": {"type": "integer", "minimum": 1, "maximum": 4096},
        "first_payload_samples": {"type": "integer", "minimum": 1, "maximum": 64},
        "post_trigger_samples": {"type": "integer", "minimum": 0, "maximum": 1024},
        "no_progress_cycles": {"type": "integer", "minimum": 1},
        "max_log_bytes": {"type": "integer", "minimum": 1024, "maximum": 67108864},
        "state_activity_consumes_qualified_budget": {"const": false},
        "multiclass_encoding": {"const": "BITMAP_ALL_TRUE_CLASSES"},
        "text_io_policy": {"const": "FIRST_SAMPLES_TRIGGER_AND_FINAL_ONLY"},
        "slowdown_limit_hard": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {
      "enum": [
        "source_produce", "queue_enqueue", "queue_dequeue",
        "consumer_accept", "internal_match_compute", "output_accept",
        "terminal_propagation", "formal_d_collection"
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "symbol_id"],
          "properties": {
            "op": {"const": "SIGNAL"},
            "symbol_id": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "symbol_ids"],
          "properties": {
            "op": {"const": "BIT_AND_NONZERO"},
            "symbol_ids": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"}
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "symbol_id", "value"],
          "properties": {
            "op": {"enum": ["EQ", "NE"]},
            "symbol_id": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"},
            "value": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {"op": {"const": "NOT"}, "arg": {"$ref": "#/$defs/predicate"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["AND", "OR"]},
            "args": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {"op": {"const": "CONST"}, "value": {"type": ["boolean", "integer"]}}
        }
      ]
    },
    "identityProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "selector"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "selector": {"type": "string", "minLength": 1}
      }
    },
    "instanceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "expected_instances", "near_miss_instances", "identity_provenance"],
      "properties": {
        "mode": {
          "enum": [
            "EXACT_CANONICAL_INSTANCE",
            "EXACT_CANONICAL_INSTANCE_SET",
            "ALL_INSTANCES_KEYED"
          ]
        },
        "expected_instances": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "near_miss_instances": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "identity_provenance": {"$ref": "#/$defs/identityProvenance"}
      }
    },
    "payloadContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_bits", "required_binary_known", "unknown_disposition"],
      "properties": {
        "width_bits": {"type": "integer", "minimum": 1, "maximum": 1024},
        "required_binary_known": {"const": true},
        "unknown_disposition": {"const": "EVIDENCE_INCOMPLETE"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "role",
        "target_module",
        "instance_scope",
        "clock_symbol_id",
        "reset",
        "stage_gate",
        "classes",
        "payload_symbol_ids",
        "payload_contract"
      ],
      "properties": {
        "boundary_id": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/role"},
        "target_module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
        "instance_scope": {"$ref": "#/$defs/instanceScope"},
        "clock_symbol_id": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"},
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["symbol_id", "active_low"],
          "properties": {
            "symbol_id": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"},
            "active_low": {"type": "boolean"}
          }
        },
        "stage_gate": {"$ref": "#/$defs/predicate"},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class_id", "bit", "progress", "trigger", "predicate"],
            "properties": {
              "class_id": {"type": "string", "minLength": 1},
              "bit": {"type": "integer", "minimum": 0, "maximum": 31},
              "progress": {"type": "boolean"},
              "trigger": {"type": "boolean"},
              "predicate": {"$ref": "#/$defs/predicate"}
            }
          }
        },
        "payload_symbol_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sym_[0-9a-f]{24}$"}
        },
        "payload_contract": {"$ref": "#/$defs/payloadContract"}
      }
    }
  }
}
