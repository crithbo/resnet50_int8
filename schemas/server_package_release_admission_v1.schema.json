{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server_package_release_admission_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pass", "status", "package_id", "family", "lifecycle", "zip_path", "checked_gates", "errors", "warnings", "claim_boundary"],
  "properties": {
    "schema": {"const": "server-package-release-admission-v1"},
    "pass": {"type": "boolean"},
    "status": {"enum": ["PACKAGE_READY_NOT_RUN", "PACKAGE_BUILD_FAILED"]},
    "package_id": {"type": "string"},
    "family": {"type": "string"},
    "lifecycle": {"type": "string"},
    "zip_path": {"type": "string"},
    "checked_gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "disposition", "fresh_result_supplied", "pass"], "properties": {"gate_id": {"type": "string"}, "disposition": {"enum": ["blocking_applicable", "receipt_reuse", "record_only", "not_applicable"]}, "fresh_result_supplied": {"type": "boolean"}, "pass": {"type": ["boolean", "null"]}}}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
