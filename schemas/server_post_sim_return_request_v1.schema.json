{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server_post_sim_return_request_v1.schema.json",
  "title": "Post-simulation shared return-core request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "result_root",
    "return_basename_template",
    "core_entries",
    "plugins",
    "max_plugin_output_bytes",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "server-post-sim-return-request-v1"},
    "package_id": {"$ref": "#/$defs/name"},
    "result_root": {"const": "/home/panqs/ndp/simresult"},
    "return_basename_template": {"const": "{package_id}_{execution_id}_return.zip"},
    "core_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_root", "source", "archive", "required"],
        "properties": {
          "source_root": {"enum": ["attempt", "package"]},
          "source": {"$ref": "#/$defs/safeRelativePath"},
          "archive": {"$ref": "#/$defs/safeRelativePath"},
          "required": {"type": "boolean"}
        }
      }
    },
    "waveform_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_member",
        "collector_member",
        "runtime_receipt_source",
        "collect_all_matching",
        "required_when_simulation_started",
        "no_size_limit",
        "manifest_archive_path"
      ],
      "properties": {
        "plan_member": {"const": "contracts/server_waveform_mandatory_plan.json"},
        "collector_member": {"const": "package_tools/server_waveform_mandatory_return.py"},
        "runtime_receipt_source": {"const": "evidence/waveform/WAVEFORM_RUNTIME_RECEIPT.json"},
        "collect_all_matching": {"const": true},
        "required_when_simulation_started": {"const": true},
        "no_size_limit": {"const": true},
        "manifest_archive_path": {"$ref": "#/$defs/safeRelativePath"}
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "argv",
          "cwd_root",
          "timeout_seconds",
          "required_for_adjudication"
        ],
        "properties": {
          "plugin_id": {"$ref": "#/$defs/name"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "cwd_root": {"enum": ["attempt", "package"]},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
          "required_for_adjudication": {"type": "boolean"}
        }
      }
    },
    "max_plugin_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$"
    }
  }
}
