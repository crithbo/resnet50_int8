{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-source-bound-final-zip-validation-v1",
  "title": "Source-bound observer exact final ZIP validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_id",
    "zip",
    "pass",
    "errors",
    "warnings",
    "all_errors_collected",
    "duplicate_members",
    "unsafe_members",
    "package_root",
    "member_receipts",
    "contract_validation",
    "exact_generation",
    "runner_checks",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "server-source-bound-final-zip-validation-v1"},
    "rule_id": {"const": "CDA-SERVER-SOURCE-BOUND-GENERATED-OBSERVER-001"},
    "zip": {"$ref": "#/$defs/fileReceipt"},
    "pass": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "all_errors_collected": {"const": true},
    "duplicate_members": {"type": "array", "items": {"type": "string"}},
    "unsafe_members": {"type": "array", "items": {"type": "string"}},
    "package_root": {"type": "string"},
    "member_receipts": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/fileReceipt"}
    },
    "contract_validation": {"type": "object"},
    "exact_generation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expected_sha256", "actual_sha256", "byte_equal"],
        "properties": {
          "expected_sha256": {"$ref": "#/$defs/sha256"},
          "actual_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "byte_equal": {"type": "boolean"}
        }
      }
    },
    "runner_checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
