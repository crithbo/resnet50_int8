{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resnet50-int8/run-manifest/0.1",
  "title": "ResNet50 INT8 run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status",
    "cache_key",
    "environment",
    "inputs",
    "contracts",
    "repositories",
    "objects",
    "stages"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["pending", "running", "succeeded", "failed", "blocked"]},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "inputs": {"type": "object"},
    "contracts": {"type": "object"},
    "repositories": {"type": "object"},
    "objects": {
      "type": "object",
      "required": ["tensors", "nodes", "hw_ops", "layouts", "configs", "executions", "results"],
      "properties": {
        "tensors": {"type": "array"},
        "nodes": {"type": "array"},
        "hw_ops": {"type": "array"},
        "layouts": {"type": "array"},
        "configs": {"type": "array"},
        "executions": {"type": "array"},
        "results": {"type": "array"}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "attempt", "status", "started_at", "finished_at", "artifacts", "error"],
        "properties": {
          "name": {"type": "string"},
          "attempt": {"type": "integer", "minimum": 1},
          "status": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "skipped"]},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]},
          "artifacts": {"type": "array"},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  },
  "additionalProperties": false
}
