{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-source-bound-final-zip-validation-v2",
  "title": "Exact target and payload final-ZIP validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "rule_id", "zip", "pass", "errors", "warnings",
    "all_errors_collected", "duplicate_members", "unsafe_members",
    "package_root", "member_receipts", "contract_validation",
    "exact_generation", "diagnostic_semantics_sha256", "plan_schema",
    "semantic_controls", "runner_checks", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "server-source-bound-final-zip-validation-v2"},
    "rule_id": {"const": "CDA-SERVER-SOURCE-BOUND-GENERATED-OBSERVER-001"},
    "zip": {"$ref": "#/$defs/fileReceipt"},
    "pass": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "all_errors_collected": {"const": true},
    "duplicate_members": {"type": "array", "items": {"type": "string"}},
    "unsafe_members": {"type": "array", "items": {"type": "string"}},
    "package_root": {"type": "string"},
    "member_receipts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/fileReceipt"}},
    "contract_validation": {"type": "object"},
    "exact_generation": {"type": "object"},
    "diagnostic_semantics_sha256": {"$ref": "#/$defs/sha256"},
    "plan_schema": {"const": "server-source-bound-probe-plan-v2"},
    "semantic_controls": {"$ref": "#/$defs/semanticControls"},
    "runner_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semanticControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "pass", "errors", "all_errors_collected",
        "diagnostic_semantics_sha256", "case_count", "positive_count",
        "negative_count", "cases", "historical_regressions", "claim_boundary"
      ],
      "properties": {
        "schema": {"const": "server-diagnostic-semantic-controls-v1"},
        "pass": {"const": true},
        "errors": {"type": "array", "maxItems": 0},
        "all_errors_collected": {"const": true},
        "diagnostic_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"type": "integer", "minimum": 9},
        "positive_count": {"type": "integer", "minimum": 1},
        "negative_count": {"type": "integer", "minimum": 7},
        "cases": {"type": "array", "minItems": 9, "items": {"type": "object"}},
        "historical_regressions": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "claim_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
