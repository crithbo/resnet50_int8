{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-observer-operational-attempt-receipt-v1",
  "title": "Observer operational attempt boundary receipt",
  "type": "object",
  "required": ["schema", "package_id", "phase", "samples", "stop_count", "trigger", "completed_rows_preserved", "flushable_rows_flushed", "process_tree_reaped", "diagnostic_status", "forbidden_claims_asserted", "pass"],
  "properties": {
    "schema": {"const": "server-observer-operational-attempt-receipt-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "phase": {"enum": ["compile", "simulation", "finalization"]},
    "samples": {"type": "array", "minItems": 1},
    "stop_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "trigger": {"type": ["object", "null"]},
    "completed_rows_preserved": {"const": true},
    "flushable_rows_flushed": {"const": true},
    "process_tree_reaped": {"const": true},
    "diagnostic_status": {"enum": ["COMPLETE", "DIAGNOSTIC_EVIDENCE_INCOMPLETE"]},
    "forbidden_claims_asserted": {"const": false},
    "pass": {"type": "boolean"}
  }
}
