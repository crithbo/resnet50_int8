{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session_handoff_activation_v1.schema.json",
  "title": "Session handoff activation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "handoff_id",
    "role_id",
    "old_thread_id",
    "new_thread_id",
    "registry_epoch_before",
    "registry_epoch_after",
    "registry_before",
    "registry_after",
    "acceptance",
    "old_owner_status",
    "new_owner_status",
    "current_mainline_thread_id",
    "activation_order",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "session-handoff-activation-v1"},
    "handoff_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "old_thread_id": {"type": "string", "minLength": 1},
    "new_thread_id": {"type": "string", "minLength": 1},
    "registry_epoch_before": {"type": "integer", "minimum": 1},
    "registry_epoch_after": {"type": "integer", "minimum": 2},
    "registry_before": {"$ref": "#/$defs/fileReceipt"},
    "registry_after": {"$ref": "#/$defs/fileReceipt"},
    "acceptance": {"$ref": "#/$defs/fileReceipt"},
    "old_owner_status": {"const": "RETIRED_READ_ONLY"},
    "new_owner_status": {"const": "ACTIVE"},
    "current_mainline_thread_id": {"type": "string", "minLength": 1},
    "activation_order": {"type": "integer", "minimum": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

