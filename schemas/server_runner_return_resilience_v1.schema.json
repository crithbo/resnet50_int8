{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-runner-return-resilience-v1.schema.json",
  "title": "Server runner definition-before-use and compile-failure return contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package_id",
    "runner_path",
    "runner_sha256",
    "nounset_required",
    "package_owned_variables",
    "bootstrap_root_variable",
    "finalizer_arm_tokens",
    "first_fallible_tokens",
    "compile_evidence_tokens",
    "return_allowlist_tokens"
  ],
  "properties": {
    "schema": {"const": "server-runner-return-resilience-contract-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "runner_path": {"type": "string", "minLength": 1},
    "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nounset_required": {"const": true},
    "package_owned_variables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
    },
    "bootstrap_root_variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "finalizer_arm_tokens": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "first_fallible_tokens": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "compile_evidence_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "source_identity", "exit_code", "driver_log", "first_error", "bounded_head", "bounded_tail"],
      "properties": {
        "argv": {"type": "string", "minLength": 1},
        "source_identity": {"type": "string", "minLength": 1},
        "exit_code": {"type": "string", "minLength": 1},
        "driver_log": {"type": "string", "minLength": 1},
        "first_error": {"type": "string", "minLength": 1},
        "bounded_head": {"type": "string", "minLength": 1},
        "bounded_tail": {"type": "string", "minLength": 1}
      }
    },
    "return_allowlist_tokens": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

