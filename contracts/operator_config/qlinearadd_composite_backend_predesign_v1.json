  },
  "w3_numeric_contract": {
    "arithmetic_order": [
      "a_center_i32 = int32(A) - int32(a_zero_point)",
      "b_center_i32 = int32(B) - int32(b_zero_point)",
      "a_center_f32 = float32(a_center_i32)",
      "b_center_f32 = float32(b_center_i32)",
      "a_scaled_f32 = round_float32(a_center_f32 * float32(a_scale))",
      "b_scaled_f32 = round_float32(b_center_f32 * float32(b_scale))",
      "sum_f32 = round_float32(a_scaled_f32 + b_scaled_f32)",
      "quotient_f32 = round_float32(sum_f32 / float32(y_scale))",
      "rounded_i64 = round_nearest_even_to_int64(quotient_f32)",
      "shifted_i64 = rounded_i64 + int64(y_zero_point)",
      "Y = uint8(clamp(shifted_i64, 0, 255))"
    ],
    "rounding": "IEEE-754 round-to-nearest-even at each float32 operation; final integer rounding is nearest-even",
    "saturation": "clamp after adding y_zero_point",
